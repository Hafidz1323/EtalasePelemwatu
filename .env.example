APP_NAME=EtalasePelemwatu
# Untuk produksi: APP_ENV=production dan APP_DEBUG=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Supabase Storage (S3-compatible)
# Ubah FILESYSTEM_DISK=supabase untuk mengaktifkan penyimpanan foto di Supabase Storage
SUPABASE_S3_KEY=your-supabase-s3-access-key-id
SUPABASE_S3_SECRET=your-supabase-s3-secret-access-key
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_BUCKET=etalase-pelemwatu
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/etalase-pelemwatu

VITE_APP_NAME="${APP_NAME}"

# Akun admin awal (dipakai oleh `php artisan db:seed`). Wajib diganti!
ADMIN_NAME="Administrator Desa"
ADMIN_EMAIL=admin@pelemwatu.desa.id
ADMIN_PASSWORD=

# Durasi token Sanctum (menit). Kosongkan atau hapus untuk tidak kedaluwarsa.
SANCTUM_EXPIRATION=480

# Trusted proxies (comma-separated IPs, atau * untuk semua). Kosongkan jika tidak di belakang proxy.
TRUSTED_PROXIES=

# --- PRODUKSI: pakai nilai berikut di server, bukan di sini ---
# APP_ENV=production
# APP_DEBUG=false

# Tampilkan nomor WA pemilik potensi pada endpoint publik (true/false). Default true.
# Set false jika ingin menyembunyikan nomor WA dari API publik.
# POTENSI_SHOW_CONTACT=true

# Path binary mysqldump untuk backup database MySQL/MariaDB.
# Contoh Windows (XAMPP): C:\xampp\mysql\bin\mysqldump.exe
# Contoh Linux/macOS: /usr/bin/mysqldump atau mysqldump (jika di PATH)
# BACKUP_MYSQLDUMP_PATH=mysqldump
